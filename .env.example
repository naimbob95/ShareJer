# Copy to .env and adjust. All values are optional; defaults shown below.

# HTTP listen port
PORT=8080

# Public base URL where share links + QR codes resolve.
# This is the FRONTEND origin (it serves the /f/{id} download page),
# not the API. In dev that's the Vite server on :5173.
BASE_URL=http://localhost:5173

# Max upload size in megabytes
MAX_UPLOAD_SIZE_MB=5

# How long a file stays reachable after upload (Go duration: 15m, 1h, 24h...).
# Set to 0 to disable expiry.
FILE_EXPIRY=15m

# How often the background sweeper deletes expired files (Go duration).
CLEANUP_INTERVAL=5m

# SQLite database file path
DB_PATH=sharejer.db

# Directory where uploaded files are stored
UPLOADS_DIR=uploads
